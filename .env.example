# Copy to .env (git-ignored) and fill in. Placeholders only.
TV_HOST=192.0.2.10          # TV IP on your LAN (TEST-NET placeholder)
TV_ADB_PORT=5555
# Release signing (alternatively private/keys/signing.properties)
MTV_STORE_FILE=/path/to/mytv-release.jks
MTV_STORE_PASSWORD=change-me
MTV_KEY_ALIAS=mytv
MTV_KEY_PASSWORD=change-me
# JDK 17+ used for Gradle builds
JAVA_HOME=/path/to/jdk-21
